rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt'])
        && request.resource.data.email == request.auth.token.email;

      // Tasks subcollection - users can only access their own tasks
      match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['title', 'completed', 'createdAt', 'userId'])
          && request.resource.data.title is string
          && request.resource.data.completed is bool
          && request.resource.data.userId == userId;
      }

      // Notes subcollection - users can only access their own notes
      match /notes/{noteId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['title', 'content', 'createdAt', 'userId'])
          && request.resource.data.title is string
          && request.resource.data.content is string
          && request.resource.data.userId == userId;
      }

      // Events subcollection - users can only access their own events
      match /events/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.resource.data.userId == userId
          && request.resource.data.keys().hasAll(['title', 'start', 'end', 'userId'])
          && request.resource.data.title is string
          && request.resource.data.userId == userId;
      }
    }

    // Scores collection - public read, admin-only write
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['driveFileId', 'name', 'publishedDate', 'createdAt', 'createdBy'])
        && request.resource.data.driveFileId is string
        && request.resource.data.name is string
        && request.resource.data.publishedDate is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && request.resource.data.keys().hasAll(['driveFileId', 'name', 'publishedDate', 'updatedAt'])
        && request.resource.data.driveFileId is string
        && request.resource.data.name is string
        && request.resource.data.publishedDate is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin();
    }

    // Courses collection - public read, authenticated write for enrolled users
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Lessons collection - public read for published courses
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Quizzes collection - public read for published courses
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User progress - users can only access their own progress
    match /progress/{progressId} {
      allow read, write: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'courseId', 'completedLessons', 'updatedAt']);
    }

    // Deny all other access
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}